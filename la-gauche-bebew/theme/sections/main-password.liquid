{%- assign s = section.settings -%}
<section class="hero hero--pancarte grain" style="--tilt: {{ s.tilt }}deg">
  <p class="hero__kicker">{{ s.kicker | escape }}</p>
  <div class="hero__sign-wrap">
    <div class="hero__sign hero__sign--pancarte">
      <span class="tape tape--1" aria-hidden="true"></span>
      <span class="tape tape--2" aria-hidden="true"></span>
      <h1 class="hero__title">{{ s.slogan | escape }}</h1>
    </div>
    <div class="hero__stick" aria-hidden="true"></div>
  </div>
  {%- if shop.password_message != blank -%}
    <p class="hero__price">{{ shop.password_message }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Bientôt en ligne",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "La Gauche Bebew" },
    { "type": "textarea", "id": "slogan", "label": "Slogan", "default": "BIENTÔT\nDANS LA RUE\nBEBEW" },
    { "type": "range", "id": "tilt", "label": "Inclinaison", "min": -6, "max": 6, "step": 0.5, "unit": "°", "default": -2 }
  ]
}
{% endschema %}
