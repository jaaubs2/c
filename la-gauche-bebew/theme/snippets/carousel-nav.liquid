{%- comment -%} Flèches d'un carrousel [data-carousel] ; masquées par theme.js s'il n'y a rien à faire défiler {%- endcomment -%}
<div class="carousel__nav">
  <button type="button" class="gallery__arrow" data-carousel-prev aria-label="{{ 'general.previous' | t }}">←</button>
  <button type="button" class="gallery__arrow" data-carousel-next aria-label="{{ 'general.next' | t }}">→</button>
</div>
