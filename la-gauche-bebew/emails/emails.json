ercase;padding:12px 22px;\">Suivre mon colis</a></p>\n{% else %}<p style=\"margin:20px 0;\"><a href=\"{{ order_status_url }}\" style=\"display:inline-block;background:#111111;color:#F6F5F1;text-decoration:none;font-family:Anton,Impact,'Arial Narrow',sans-serif;font-size:18px;text-transform:uppercase;padding:12px 22px;\">Voir ma commande</a></p>\n{% endif %}{% if fulfillment.tracking_number %}<p style=\"margin:0 0 14px;\"><span style=\"font-size:13px;color:#555555;\">Numéro de suivi : {{ fulfillment.tracking_number }}</span></p>\n{% endif %}\n</td></tr>\n<tr><td style=\"padding:16px 24px;background:#111111;color:#F6F5F1;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;\">\nUne question ? Réponds à ce mail ou écris à <a href=\"mailto:lagauchebebew@gmail.com\" style=\"color:#F6F5F1;\">lagauchebebew@gmail.com</a>.<br>\n<a href=\"https://gauchebebew.com\" style=\"color:#F6F5F1;\">gauchebebew.com</a> · <a href=\"https://www.tiktok.com/@la.gauche.bebew\" style=\"color:#F6F5F1;\">TikTok</a>\n</td></tr>\n</table></td></tr></table>\n</body></html>"
