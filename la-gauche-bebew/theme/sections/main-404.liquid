<div class="notfound">
  <p class="notfound__code">{{ 'not_found.code' | t }}</p>
  <h1 class="display notfound__title">{{ section.settings.title | escape }}</h1>
  <p class="newsletter__text">{{ section.settings.text | escape }}</p>
  <a href="{{ settings.shop_collection.url | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button | escape }} {% render 'icon', name: 'arrow' %}</a>
</div>

{% schema %}
{
  "name": "Page introuvable",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Page introuvable. Comme le pouvoir d'achat." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Cette page a disparu. Les slogans, eux, sont toujours là." },
    { "type": "text", "id": "button", "label": "Bouton", "default": "Voir les slogans" }
  ]
}
{% endschema %}
