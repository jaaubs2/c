{%- if section.settings.text != blank -%}
  {%- comment -%}
    Le texte est doublé pour défiler en boucle sur téléphone (une seule ligne) ; la copie est masquée ailleurs.
  {%- endcomment -%}
  <div class="announce" {{ section.shopify_attributes }}>
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" class="announce__link">{%- endif -%}
    <span class="announce__track">
      <span class="announce__text">{{ section.settings.text | escape }}<span class="announce__sep" aria-hidden="true">&nbsp;·&nbsp;</span></span>
      <span class="announce__text announce__copy" aria-hidden="true">{{ section.settings.text | escape }}<span class="announce__sep">&nbsp;·&nbsp;</span></span>
    </span>
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau annonce",
  "class": "section-announce",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "2 t-shirts = 35 € · Livraison offerte dès 50 € · Expédié sous 72 h"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien (facultatif)"
    }
  ],
  "presets": [{ "name": "Bandeau annonce" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
