<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {% render 'meta-tags' %}
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>window.theme = { routes: {}, strings: { emailError: {{ 'newsletter.error' | t | json }} } };</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body class="btn-style-{{ settings.button_style }}">
    <div class="password">
      <header class="header">
        <div class="header__bar" style="grid-template-columns: 1fr">
          <span class="header__brand">{{ shop.name }}</span>
        </div>
      </header>
      <main id="MainContent" class="password__main">
        {{ content_for_layout }}
      </main>
      <div class="password__login">
        <details>
          <summary class="link-mono" style="cursor:pointer;justify-content:center">{{ 'password.owner' | t }}</summary>
          {%- form 'storefront_password', class: 'search-form' -%}
            {%- if form.errors -%}<p class="form-error" role="alert">{{ 'password.error' | t }}</p>{%- endif -%}
            <label for="Password" class="visually-hidden">{{ 'password.label' | t }}</label>
            <input class="input" type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
            <button type="submit" class="btn">{{ 'password.submit' | t }}</button>
          {%- endform -%}
        </details>
        {% render 'payment-icons' %}
      </div>
    </div>
  </body>
</html>
