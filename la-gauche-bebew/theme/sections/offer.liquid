{%- liquid
  assign s = section.settings
  assign dark = true
  if s.style == 'light'
    assign dark = false
  endif
-%}
<section class="offer {% if dark %}grain grain--screen on-dark{% else %}offer--light grain{% endif %}">
  <h2 class="display offer__title">{{ s.title | escape | newline_to_br }}</h2>
  <div class="offer__body">
    {%- if s.text != blank -%}<div class="offer__text">{{ s.text }}</div>{%- endif -%}
    {%- assign lines = s.list | newline_to_br | split: '<br />' -%}
    {%- if s.list != blank -%}
      <ul class="arrow-list">
        {%- for line in lines -%}
          {%- assign l = line | strip -%}
          {%- if l != blank -%}<li>→ {{ l | escape }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <a href="{{ s.button_link | default: '#slogans' }}" class="btn{% if dark %} btn--inverse{% endif %}">{{ s.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bloc offre",
  "class": "section-offer",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "Noire" },
        { "value": "light", "label": "Claire" }
      ]
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Titre",
      "default": "2 t-shirts\n= 35 €"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Au lieu de 40 €. Mélange les slogans et les coupes : la réduction s'applique toute seule dans ton panier.</p>"
    },
    {
      "type": "textarea",
      "id": "list",
      "label": "Liste (une ligne = un point)",
      "default": "Livraison offerte dès 50 €\nExpédié sous 72 h\nLivraison en France uniquement"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Prends-en deux"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton",
      "info": "Par défaut : #slogans (la grille de l'accueil)"
    }
  ],
  "presets": [{ "name": "Bloc offre" }]
}
{% endschema %}
