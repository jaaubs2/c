# Copie ce fichier sous le nom « .env.local » et remplis-le (voir docs/SUPABASE.md).
# Sans ces valeurs, l'app reste en mode démo.

# Adresse du projet Supabase (Project URL)
VITE_SUPABASE_URL=

# Clé publique « anon » (ou « publishable »). Jamais la clé « service_role » / « secret ».
VITE_SUPABASE_ANON_KEY=

# Adresse publique de l'app, utilisée dans les liens partagés (quand l'app est en ligne).
# Exemple : https://app.lecarnetvivant.fr/
VITE_PUBLIC_URL=
