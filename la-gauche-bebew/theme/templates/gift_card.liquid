{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  </head>
  <body class="btn-style-{{ settings.button_style }}">
    <div class="notfound">
      <p class="notfound__code">{{ shop.name }}</p>
      <h1 class="display notfound__title">{{ 'gift_card.title' | t }}</h1>
      {%- assign initial_value = gift_card.initial_value | money_without_trailing_zeros | remove: '€' | strip | append: ' €' -%}
      <p class="display h2">{{ gift_card.balance | money_without_trailing_zeros | remove: '€' | strip | append: ' €' }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="mono">{{ 'gift_card.initial' | t: value: initial_value }}</p>
      {%- endif -%}
      {%- if gift_card.expired or gift_card.enabled == false -%}
        <p class="form-error">{{ 'gift_card.expired' | t }}</p>
      {%- endif -%}
      <p class="meter" style="font-family: var(--mono); font-size: 22px; letter-spacing: .1em">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <a href="{{ shop.url }}" class="btn">{{ 'gift_card.shop' | t }}</a>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="link-mono">Apple Wallet</a>
      {%- endif -%}
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
