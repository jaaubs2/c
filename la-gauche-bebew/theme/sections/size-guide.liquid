{%- assign s = section.settings -%}
<header class="page-head">
  {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
  <h1 class="display page-head__title">{{ s.title | escape }}</h1>
</header>

<div class="size-guide">
  {%- if s.note != blank -%}<div class="size-guide__note">{{ s.note }}</div>{%- endif -%}

  <div class="size-table-wrap">
    <table class="size-table">
      <thead>
        <tr>
          <th scope="col">{{ 'size_guide.size' | t }}</th>
          <th scope="col">{{ s.col_1 | escape }}</th>
          <th scope="col">{{ s.col_2 | escape }}</th>
          <th scope="col">{{ s.col_3 | escape }}</th>
          <th scope="col">{{ s.col_4 | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.size | escape }}</th>
            <td>{{ block.settings.v1 | escape }}</td>
            <td>{{ block.settings.v2 | escape }}</td>
            <td>{{ block.settings.v3 | escape }}</td>
            <td>{{ block.settings.v4 | escape }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>

  <div class="size-guide__how">
    <div><strong>{{ s.how_1_title | escape }}</strong><span>{{ s.how_1_text | escape }}</span></div>
    <div><strong>{{ s.how_2_title | escape }}</strong><span>{{ s.how_2_text | escape }}</span></div>
    <div><strong>{{ s.how_3_title | escape }}</strong><span>{{ s.how_3_text | escape }}</span></div>
  </div>
</div>

{% schema %}
{
  "name": "Guide des tailles",
  "class": "section-size-guide",
  "settings": [
    {
      "type": "paragraph",
      "content": "⚠ Les mesures par défaut sont des exemples : remplace-les par celles du fournisseur de tes t-shirts (une ligne = un bloc « Taille »)."
    },
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "XS → XXL · Homme et Femme" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Guide des tailles" },
    { "type": "richtext", "id": "note", "label": "Texte", "default": "<p>Mesures du t-shirt posé à plat, en centimètres. Compare avec un t-shirt que tu portes déjà. Entre deux tailles ? Prends au-dessus.</p>" },
    { "type": "text", "id": "col_1", "label": "Colonne 1", "default": "Homme · largeur" },
    { "type": "text", "id": "col_2", "label": "Colonne 2", "default": "Homme · longueur" },
    { "type": "text", "id": "col_3", "label": "Colonne 3", "default": "Femme · largeur" },
    { "type": "text", "id": "col_4", "label": "Colonne 4", "default": "Femme · longueur" },
    { "type": "header", "content": "Comment mesurer" },
    { "type": "text", "id": "how_1_title", "label": "Encadré 1 : titre", "default": "Largeur" },
    { "type": "text", "id": "how_1_text", "label": "Encadré 1 : texte", "default": "D'une aisselle à l'autre, t-shirt à plat." },
    { "type": "text", "id": "how_2_title", "label": "Encadré 2 : titre", "default": "Longueur" },
    { "type": "text", "id": "how_2_text", "label": "Encadré 2 : texte", "default": "Du haut de l'épaule au bas du t-shirt." },
    { "type": "text", "id": "how_3_title", "label": "Encadré 3 : titre", "default": "Après lavage" },
    { "type": "text", "id": "how_3_text", "label": "Encadré 3 : texte", "default": "Lavé à 30° à l'envers et sans sèche-linge, il garde sa taille." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Taille",
      "settings": [
        { "type": "text", "id": "size", "label": "Taille", "default": "M" },
        { "type": "text", "id": "v1", "label": "Colonne 1" },
        { "type": "text", "id": "v2", "label": "Colonne 2" },
        { "type": "text", "id": "v3", "label": "Colonne 3" },
        { "type": "text", "id": "v4", "label": "Colonne 4" }
      ]
    }
  ],
  "presets": [{ "name": "Guide des tailles" }]
}
{% endschema %}
