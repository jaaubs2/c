{%- if section.settings.text != blank -%}
  <div class="announce" {{ section.shopify_attributes }}>
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau annonce",
  "class": "section-announce",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "2 t-shirts = 35 € · Livraison offerte dès 50 € · Expédié sous 72 h"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien (facultatif)"
    }
  ],
  "presets": [{ "name": "Bandeau annonce" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
