{%- comment -%}
  Barre noire sous le header : où en est l'offre 2 pour 35 € et la livraison offerte.
  Rafraîchie par theme.js après chaque ajout au panier.
{%- endcomment -%}
<div data-refresh="cart-bar">
  {%- if settings.show_cart_bar and cart.item_count > 0 -%}
    {%- liquid
      assign threshold = settings.free_shipping_threshold | times: 100
      assign remaining = threshold | minus: cart.total_price
      assign total_display = cart.total_price | money_without_trailing_zeros
      assign remaining_display = remaining | money_without_trailing_zeros
      assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
      if threshold == 0
        assign progress = 100
      endif
    -%}
    <div class="cart-bar on-dark">
      <p>
        {%- if cart.item_count == 1 -%}
          {{ 'cart.bar_one' | t: pair_price: settings.pair_price }}
        {%- else -%}
          {{ 'cart.bar_many' | t: count: cart.item_count, total: total_display, pair_price: settings.pair_price }}
          {% if remaining <= 0 -%}
            {{ 'cart.bar_free' | t }}
          {%- else -%}
            {{ 'cart.bar_remaining' | t: amount: remaining_display }}
          {%- endif -%}
        {%- endif %}
        <a href="{{ routes.cart_url }}">{{ 'cart.see' | t }}</a>
      </p>
      <div class="progress" role="progressbar" aria-label="{{ 'cart.shipping_progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}"><span style="width: {{ progress }}%"></span></div>
    </div>
  {%- endif -%}
</div>
