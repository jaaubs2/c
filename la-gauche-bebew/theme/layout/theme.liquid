<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    {%- liquid
      comment
        SEO : /collections/all (et frontpage) montrent les mêmes t-shirts que la collection « Boutique » (en français) ;
        on indique à Google la version à garder. Titre et description de l'accueil depuis les réglages du thème.
      endcomment
      assign seo_canonical = canonical_url
      if template.name == 'collection' and settings.shop_collection.url != blank
        if collection.handle == 'all' or collection.handle == 'frontpage'
          assign seo_canonical = request.origin | append: settings.shop_collection.url
        endif
      endif
      assign seo_title = page_title
      assign seo_description = page_description
      if request.page_type == 'index'
        if page_title == shop.name and settings.seo_home_title != blank
          assign seo_title = settings.seo_home_title
        endif
        if seo_description == blank
          assign seo_description = settings.seo_home_description
        endif
      endif
    -%}
    <link rel="canonical" href="{{ seo_canonical }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ seo_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; page {{ current_page }}{% endif -%}
      {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if seo_description != blank -%}
      <meta name="description" content="{{ seo_description | strip_newlines | escape }}">
    {%- endif -%}

    {% render 'meta-tags', seo_title: seo_title, seo_description: seo_description, seo_canonical: seo_canonical %}

    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'fit.css' | asset_url | stylesheet_tag }}

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        },
        strings: {
          added: {{ 'product.added' | t | json }},
          addedShort: {{ 'product.added_short' | t | json }},
          adding: {{ 'product.adding' | t | json }},
          addToCart: {{ 'product.add_to_cart' | t | json }},
          soldOut: {{ 'product.sold_out' | t | json }},
          unavailable: {{ 'product.unavailable' | t | json }},
          chooseSize: {{ 'product.choose_size' | t | json }},
          error: {{ 'general.error' | t | json }},
          viewCart: {{ 'product.view_cart' | t | json }},
          close: {{ 'general.close' | t | json }},
          emailError: {{ 'newsletter.error' | t | json }},
          sizeGuide: {{ 'product.size_guide' | t | json }}
        },
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="btn-style-{{ settings.button_style }} template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}
    <script>
      (function () {
        var a = document.querySelector('.section-announce'), h = document.querySelector('.section-header'), r = document.documentElement.style;
        r.setProperty('--announce-h', (a ? a.offsetHeight : 0) + 'px');
        if (h) r.setProperty('--chrome-h', (h.offsetTop + h.offsetHeight) + 'px');
      })();
    </script>

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'quick-add-dialog' %}
  </body>
</html>
